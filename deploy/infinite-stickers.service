[Unit]
Description=Infinite Stickers personal timeline
After=network.target

[Service]
Type=simple
User=stickers
Group=stickers
WorkingDirectory=/opt/infinite-stickers
ExecStart=/usr/bin/python3 /opt/infinite-stickers/server.py --host 127.0.0.1 --port 8787 --data-dir /var/lib/infinite-stickers --secure-cookie
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/infinite-stickers

[Install]
WantedBy=multi-user.target
